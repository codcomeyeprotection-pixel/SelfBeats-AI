modules = ["python-3.11"]
run = "python main.py"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PYTHON"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
